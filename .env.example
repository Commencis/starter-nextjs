# Next.js
NEXT_TELEMETRY_DISABLED=1

# development | test | uat | staging | production.
NEXT_PUBLIC_ENVIRONMENT=development

# canonical site origin. Falls back to the incoming request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: public API origin used by the browser.
# NEXT_PUBLIC_BASE_API_URL=https://api.example.com

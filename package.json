{
  "name": "@commencis/starter-nextjs",
  "version": "3.1.0",
  "buildNumber": 1,
  "description": "Commencis Starter - NextJS",
  "author": "Commencis WEB Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "analyze": "next experimental-analyze",
    "update:deps": "pnpm update --latest",
    "update:lockfile": "pnpm update --no-save",
    "lint:check:types": "tsc --noEmit",
    "lint:check:js": "eslint .",
    "lint:fix:js": "eslint . --fix",
    "lint:check:css": "stylelint **/*.{css,scss}",
    "lint:fix:css": "stylelint **/*.{css,scss} --fix",
    "lint:check:format": "prettier \"**/*.{json,md}\" --check",
    "lint:fix:format": "prettier \"**/*.{json,md}\" --write",
    "lint": "pnpm run \"/^lint:check:.*/\"",
    "lint:fix": "pnpm run \"/^lint:fix:.*/\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "generate:env": "tsx scripts/env/generateEnv.ts",
    "generate:icons": "tsx scripts/svg/generateSvg.ts icons",
    "generate:vectors": "tsx scripts/svg/generateSvg.ts vectors",
    "ci:review": "SKIP_ENV_VALIDATION=true pnpm run typegen && pnpm run lint",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
    "bump:version": "./scripts/bump/version.sh",
    "bump:build": "./scripts/bump/build.sh",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-remove-scroll": "2.7.2",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commencis/commitlint-config": "4.1.0",
    "@commencis/eslint-config": "3.8.0",
    "@commencis/lint-staged-config": "3.3.0",
    "@commencis/prettier-config": "3.4.0",
    "@commencis/stylelint-config": "3.6.0",
    "@commitlint/cli": "21.2.4",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@svgr/cli": "8.1.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "changesets-changelog-clean": "1.4.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "storybook": "10.6.3",
    "stylelint": "17.16.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
